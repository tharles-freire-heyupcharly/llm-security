# Copie para .env e ajuste. NUNCA commite a chave real.

# Motor de LLM: mock (padrão, reproduzível), local (open-source via Ollama) ou real
LLM_MODE=mock

# Modelo no modo real (Anthropic / Claude)
LLM_MODEL=claude-opus-4-8

# Chave da API — apenas no modo real
ANTHROPIC_API_KEY=

# Motor local (Ollama): endereço e modelo. Ver README.md ("Memória do Ollama")
# se o container matar o processo ao carregar o modelo por falta de RAM.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Identifica a instância/financeira (demos multi-tenant)
TENANT_ID=credsim-demo

# Estado inicial das defesas (também alternável pela UI/notebooks)
DEFENSE_INPUT_VALIDATION=false
DEFENSE_OUTPUT_VALIDATION=false
DEFENSE_LEAST_PRIVILEGE=false
DEFENSE_API_SECURITY=false

# 5ª camada (Aulas 1/3), mesma convenção das defesas acima: false (padrão) =
# vulnerável — força obediência cega no modo local/real, garantindo que o
# ataque de injeção/XSS funciona sempre (igual ao mock). true = liga o
# alinhamento NATIVO do modelo, que pode bloquear o ataque sozinho.
DEFENSE_MODEL_ALIGNMENT=false
