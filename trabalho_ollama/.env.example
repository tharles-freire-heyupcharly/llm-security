# Modelo baixado automaticamente pelo serviço `ollama-pull` no primeiro boot.
# llama3.2:3b é leve o bastante para rodar em CPU (notebook comum). Troque por
# um modelo maior (ex.: llama3.1:8b, qwen2.5:7b) se tiver GPU ou mais RAM.
OLLAMA_MODEL=llama3.2:3b

# Timeout (segundos) de cada chamada ao Ollama. Aumente se o modelo demorar
# muito para responder na sua máquina.
OLLAMA_TIMEOUT=60
