# Copie para .env (na raiz) e ajuste. O docker compose lê este arquivo.
# NUNCA commite a chave real.

# Motor de LLM: mock (padrão, reproduzível), local (open-source via Ollama,
# só a v2 — lab/app_v2/) ou real
LLM_MODE=mock

# Modelo no modo real (Anthropic / Claude)
LLM_MODEL=claude-opus-4-8

# Chave da API — apenas no modo real
ANTHROPIC_API_KEY=

# Modelo open-source no modo local (v2). Precisa de ~3-4 GB de RAM alocados
# ao Docker Desktop; troque por um modelo menor (ex.: qwen2.5:1.5b) se faltar
# memória (ver lab/app_v2/README.md, "Memória do Ollama").
OLLAMA_MODEL=llama3.2:3b

# 5ª camada de defesa da v2 (Aulas 1/3), mesma convenção das demais: false
# (padrão) = vulnerável — força o modelo (local/real) a obedecer cegamente ao
# ataque de injeção/XSS, garantindo que ele funciona mesmo com um modelo bem
# alinhado. true = liga o alinhamento nativo do modelo, que pode bloquear o
# ataque sozinho (ver lab/app_v2/README.md).
DEFENSE_MODEL_ALIGNMENT=false

# Atraso artificial (segundos) só no modo mock da v2 — sem ele a resposta
# volta instantânea (é só montagem de string) e não parece uma chamada de IA
# de verdade numa gravação. 0 desliga (usado nos testes). O compose já aplica
# 1.0 por padrão no container; suba pra ~1.5-2.0 se ainda parecer rápido.
MOCK_THINKING_DELAY=1.0
